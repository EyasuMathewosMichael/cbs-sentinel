SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel_user:Your_Password@127.0.0.1:5432/sentinel
SENTINEL_DB_POOL_SIZE=5
SENTINEL_DB_MAX_OVERFLOW=10
SENTINEL_REDIS_URL=redis://127.0.0.1:6379/0
SENTINEL_REDIS_MAX_CONNECTIONS=20
SENTINEL_MTLS_REQUIRED=true
SENTINEL_MIN_TLS_VERSION=TLSv1.3
SENTINEL_SECRETS_BACKEND=external
SENTINEL_KMS_PROVIDER=external-kms
SENTINEL_HSM_REQUIRED=true
SENTINEL_IAM_BACKEND=external-iam
